{
  "name": "yeollin-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open, extensible CMS framework inspired by Tauri",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:api": "cargo run -p yeollin-app",
    "dev:web": "bun --filter @yeollin/app dev",
    "build": "bun --filter '*' build",
    "build:api": "cargo build --release -p yeollin-app",
    "build:web": "bun --filter @yeollin/app build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "cargo check --workspace"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-devup": "^2.1",
    "oxlint": "^1.80",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
