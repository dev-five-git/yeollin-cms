{
  "$schema": "https://devup-ui.com/schema/devup.json",
  "theme": {
    "colors": {
      "default": {
        "primary": "#0070f3",
        "primaryHover": "#0060df",
        "background": "#ffffff",
        "backgroundSecondary": "#f5f5f5",
        "text": "#171717",
        "textSecondary": "#666666",
        "textTertiary": "#999999",
        "border": "#e5e5e5",
        "success": "#10b981",
        "error": "#ef4444",
        "warning": "#f59e0b"
      },
      "dark": {
        "primary": "#3291ff",
        "primaryHover": "#52a8ff",
        "background": "#0a0a0a",
        "backgroundSecondary": "#1a1a1a",
        "text": "#ededed",
        "textSecondary": "#a1a1a1",
        "textTertiary": "#666666",
        "border": "#2e2e2e",
        "success": "#34d399",
        "error": "#f87171",
        "warning": "#fbbf24"
      }
    },
    "typography": {
      "heading": {
        "fontFamily": "var(--font-geist-sans)",
        "fontSize": "24px",
        "fontWeight": 700,
        "lineHeight": 1.3
      },
      "subheading": {
        "fontFamily": "var(--font-geist-sans)",
        "fontSize": "18px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "body": {
        "fontFamily": "var(--font-geist-sans)",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "label": {
        "fontFamily": "var(--font-geist-sans)",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.4
      }
    }
  }
}
